#!/bin/bash
set -e

echo "[JX-OS] Configuring XFCE desktop..."

SKEL="/etc/skel"
XFCE_CONF="$SKEL/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$XFCE_CONF"

# ============================================================
# XFCE4 DESKTOP - wallpaper, icons, behaviour
# ============================================================
cat > "$XFCE_CONF/xfce4-desktop.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/jxos/wallpaperdefault.png"/>
        </property>
      </property>
    </property>
  </property>
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="0"/>
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="false"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="true"/>
      <property name="show-trash" type="bool" value="false"/>
    </property>
  </property>
</channel>
EOF

# ============================================================
# XFCE4 PANEL - taskbar layout
# ============================================================
cat > "$XFCE_CONF/xfce4-panel.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
  </property>
  <property name="panel-1" type="empty">
    <property name="position" type="string" value="p=6;x=0;y=0"/>
    <property name="length" type="uint" value="100"/>
    <property name="position-locked" type="bool" value="true"/>
    <property name="size" type="uint" value="28"/>
    <property name="icon-size" type="uint" value="16"/>
    <property name="nrows" type="uint" value="1"/>
    <property name="plugin-ids" type="array">
      <value type="int" value="1"/>
      <value type="int" value="2"/>
      <value type="int" value="3"/>
      <value type="int" value="4"/>
      <value type="int" value="5"/>
      <value type="int" value="6"/>
      <value type="int" value="7"/>
    </property>
    <property name="background-style" type="uint" value="1"/>
    <property name="background-color" type="array">
      <!-- #111118 at ~96% opacity -->
      <value type="uint" value="4369"/>
      <value type="uint" value="4369"/>
      <value type="uint" value="6168"/>
      <value type="uint" value="61680"/>
    </property>
    <property name="enter-opacity" type="uint" value="100"/>
    <property name="leave-opacity" type="uint" value="100"/>
  </property>
  <property name="plugins" type="empty">
    <!-- App launcher / whisker menu -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="show-button-title" type="bool" value="false"/>
      <property name="button-icon-name" type="string" value="/usr/share/jxos/logos/logo-256.png"/>
    </property>
    <!-- Spacer between launcher and tasklist -->
    <property name="plugin-2" type="string" value="separator">
      <property name="expand" type="bool" value="false"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <!-- Window list -->
    <property name="plugin-3" type="string" value="tasklist">
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-labels" type="bool" value="true"/>
      <property name="grouping" type="uint" value="1"/>
      <property name="include-all-workspaces" type="bool" value="false"/>
      <property name="middle-click" type="uint" value="1"/>
    </property>
    <!-- Push clock and tray to the right -->
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <!-- System tray - notifications, NM, etc -->
    <property name="plugin-5" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="uint" value="14"/>
    </property>
    <!-- Volume -->
    <property name="plugin-6" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications" type="bool" value="true"/>
    </property>
    <!-- Clock - accent green, 24h, minimal -->
    <property name="plugin-7" type="string" value="clock">
      <property name="digital-format" type="string" value="&lt;span color='#00ff91' font='JetBrains Mono SemiBold 9'&gt;%H:%M&lt;/span&gt;  &lt;span color='#8888a0' font='JetBrains Mono 9'&gt;%d %b&lt;/span&gt;"/>
      <property name="mode" type="uint" value="4"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>
  </property>
</channel>
EOF

# ============================================================
# XFWM4 - window manager style
# ============================================================
cat > "$XFCE_CONF/xfwm4.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Numix"/>
    <property name="title_font" type="string" value="JetBrains Mono SemiBold 9"/>
    <property name="title_alignment" type="string" value="left"/>
    <property name="button_layout" type="string" value="CMH|"/>
    <property name="frame_opacity" type="int" value="100"/>
    <property name="inactive_opacity" type="int" value="100"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="true"/>
    <property name="snap_width" type="int" value="10"/>
    <property name="snap_resist" type="bool" value="false"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
    <property name="wrap_windows" type="bool" value="false"/>
    <property name="borderless_maximize" type="bool" value="true"/>
    <property name="tile_on_move" type="bool" value="true"/>
    <property name="placement_ratio" type="int" value="20"/>
    <property name="double_click_action" type="string" value="maximize"/>
    <property name="mousewheel_rollup" type="bool" value="false"/>
  </property>
</channel>
EOF

# Install xfwm4-themes (provides Numix wm theme as a clean base)
# The GTK theme handles the actual look; XFWM just needs its
# decoration layer. We override with a custom xfwm4 theme below.
mkdir -p /usr/share/themes/JX-OS/xfwm4

# Minimal xfwm4 theme - thin titlebar, accent close button
cat > /usr/share/themes/JX-OS/xfwm4/themerc << 'EOF'
# JX-OS xfwm4 theme
# Thin titlebars, accent-coloured focus indicator

active_text_color=#ffffff
inactive_text_color=#8888a0
active_color_1=#111118
active_hilight_1=#00ff91
active_color_2=#111118
active_hilight_2=#111118
inactive_color_1=#0d0d14
inactive_hilight_1=#2a2a38
inactive_color_2=#0d0d14
inactive_hilight_2=#0d0d14
active_border_color=#2a2a38
inactive_border_color=#1a1a26
active_mid_color=#111118
inactive_mid_color=#0d0d14
active_shadow_color=#000000
inactive_shadow_color=#000000
title_shadow_active=false
title_shadow_inactive=false
button_offset=2
button_spacing=2
border_width=1
bottom_height=0
maximized_offset=0
shadow_delta_height=-1
shadow_delta_width=-2
shadow_delta_x=0
shadow_delta_y=0
shadow_opacity=0
show_popup_shadow=false
show_frame_shadow=false
show_dock_shadow=false
full_width_title=true
title_vertical_offset_active=2
title_vertical_offset_inactive=2
EOF

# Update xfwm4 to use our theme
sed -i 's/value="Numix"/value="JX-OS"/' "$XFCE_CONF/xfwm4.xml"

# ============================================================
# XSETTINGS - GTK appearance
# ============================================================
cat > "$XFCE_CONF/xsettings.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="JX-OS"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
    <property name="CursorThemeName" type="string" value="Adwaita"/>
    <property name="CursorThemeSize" type="int" value="24"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Noto Sans 10"/>
    <property name="MonospaceFontName" type="string" value="JetBrains Mono 10"/>
    <property name="MenuImages" type="bool" value="false"/>
    <property name="ButtonImages" type="bool" value="false"/>
    <property name="ToolbarStyle" type="string" value="icons"/>
    <property name="DecorationLayout" type="string" value="close,minimize,maximize:"/>
  </property>
  <property name="Xft" type="empty">
    <property name="DPI" type="int" value="96"/>
    <property name="Antialias" type="int" value="1"/>
    <property name="Hinting" type="int" value="1"/>
    <property name="HintStyle" type="string" value="hintslight"/>
    <property name="RGBA" type="string" value="rgb"/>
  </property>
</channel>
EOF

# ============================================================
# XFCE4 TERMINAL - dark theme matching palette
# ============================================================
mkdir -p "$SKEL/.config/xfce4/terminal"
cat > "$SKEL/.config/xfce4/terminal/terminalrc" << 'EOF'
[Configuration]
FontName=JetBrains Mono 11
MiscDefaultGeometry=100x30
MiscInheritGeometry=FALSE
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscBellType=TERMINAL_BELL_NONE
BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT
BackgroundDarkness=0.9
ColorForeground=#00ff91
ColorBackground=#0d0d14
ColorCursor=#00ff91
ColorPalette=#0d0d14;#dc143c;#00ff91;#ffcc00;#0087ff;#ab00ff;#00e5ff;#8888a0;#2a2a38;#ff4466;#33ffaa;#ffdd55;#33aaff;#cc44ff;#44eeff;#ffffff
TabActivityColor=#00ff91
EOF

# ============================================================
# PICOM - compositor (rounded corners, shadows, subtle fades)
# Intentional restraint: one visual statement (the corner radius
# + shadow system), everything else quiet.
# ============================================================
mkdir -p "$SKEL/.config/picom"
cat > "$SKEL/.config/picom/picom.conf" << 'EOF'
# JX-OS Picom — intentional, not decorative

backend = "glx";
vsync = true;
glx-no-stencil = true;
use-damage = true;

# --- Rounded corners ---
# 12px on all windows. Panel and desktop excluded so they
# don't get clipped edges. This is the one bold visual call.
corner-radius = 12;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'xfce4-panel'"
];

# --- Shadows ---
# Soft, low-spread shadow. Enough depth without drama.
shadow = true;
shadow-radius = 16;
shadow-offset-x = -8;
shadow-offset-y = -4;
shadow-opacity = 0.45;
shadow-color = "#000000";
shadow-exclude = [
  "name = 'Notification'",
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'xfce4-panel'",
  "_GTK_FRAME_EXTENTS@:c"
];

# --- Fading ---
# Short, snappy. Not slow cinema fades.
fading = true;
fade-in-step = 0.08;
fade-out-step = 0.08;
fade-delta = 5;
fade-exclude = [
  "window_type = 'dock'"
];

# --- Opacity ---
# Active windows fully opaque. Inactive windows slightly dim.
# Terminal gets slight transparency so you can see behind it.
inactive-opacity = 0.94;
active-opacity = 1.0;
frame-opacity = 1.0;
inactive-opacity-override = false;
opacity-rule = [
  "88:class_g = 'xfce4-terminal' && focused",
  "80:class_g = 'xfce4-terminal' && !focused"
];

# --- Blur ---
# Only on terminal background. Subtle, not distracting.
blur-method = "dual_kawase";
blur-strength = 4;
blur-background = false;
blur-background-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g != 'xfce4-terminal'"
];
EOF

# ============================================================
# AUTOSTART - picom, MAC randomiser reminder
# ============================================================
mkdir -p "$SKEL/.config/autostart"
cat > "$SKEL/.config/autostart/picom.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Picom
Exec=picom --daemon
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF

# ============================================================
# WHISKER MENU CONFIG
# ============================================================
mkdir -p "$SKEL/.config/xfce4/panel/whiskermenu-1.rc"
cat > "$SKEL/.config/xfce4/panel/whiskermenu-1.rc" << 'EOF'
button-title=
button-icon=/usr/share/jxos/logos/logo-256.png
button-style=2
category-icon-size=0
command-settings=xfce4-settings-manager
command-lockscreen=xflock4
command-switchuser=
command-logoutdialog=xfce4-session-logout
command-manualurl=
item-icon-size=2
hover-switch-category=false
display-recent=false
display-favorites=true
recent-items-max=0
position-categories-alternate=false
position-commands-alternate=false
position-search-alternate=false
sort-categories=true
item-icon-size=2
EOF

# ============================================================
# THUNAR - clean sidebar, no desktop icons, single-click
# ============================================================
mkdir -p "$SKEL/.config/Thunar"
cat > "$SKEL/.config/Thunar/thunarrc" << 'EOF'
[Configuration]
LastShowHidden=FALSE
LastSidebarWidth=180
LastSplitterPosition=180
LastStatusBarActiveState=TRUE
LastView=ThunarDetailsView
LastWindowHeight=480
LastWindowWidth=720
MiscShowThumbnails=TRUE
MiscThumbnailSize=THUNAR_THUMBNAIL_SIZE_NORMAL
MiscSingleClick=FALSE
MiscRememberGeometry=TRUE
SidebarVisible=TRUE
StatusbarVisible=TRUE
ToolbarVisible=TRUE
EOF

cat > "$SKEL/.config/Thunar/bookmarks" << 'EOF'
file:///home/jxos/Documents Documents
file:///home/jxos/Downloads Downloads
file:///home/jxos/Pictures Pictures
EOF

# ============================================================
# GTK3 user overrides
# ============================================================
mkdir -p "$SKEL/.config/gtk-3.0"
cat > "$SKEL/.config/gtk-3.0/settings.ini" << 'EOF'
[Settings]
gtk-theme-name=JX-OS
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=1
gtk-button-images=0
gtk-menu-images=0
gtk-enable-animations=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
EOF

# GTK2 fallback
cat > "$SKEL/.gtkrc-2.0" << 'EOF'
include "/usr/share/themes/JX-OS/gtk-2.0/gtkrc"
gtk-icon-theme-name="Papirus-Dark"
gtk-cursor-theme-name="Adwaita"
gtk-font-name="Noto Sans 10"
EOF

# ============================================================
# DEFAULT HOME FOLDERS
# ============================================================
mkdir -p "$SKEL/Documents"
mkdir -p "$SKEL/Downloads"
mkdir -p "$SKEL/Pictures"

# ============================================================
# XFCE4 NOTIFY - match JX-OS theme
# ============================================================
mkdir -p /usr/share/xfce4/notify
cat > "$XFCE_CONF/xfce4-notifyd.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-notifyd" version="1.0">
  <property name="theme" type="string" value="Default"/>
  <property name="notify-location" type="uint" value="2"/>
  <property name="initial-opacity" type="double" value="0.92"/>
  <property name="expire-timeout" type="int" value="4"/>
  <property name="do-fadeout" type="bool" value="true"/>
  <property name="do-slideout" type="bool" value="false"/>
  <property name="notify-max-recent-items" type="uint" value="10"/>
</channel>
EOF

echo "[JX-OS] XFCE desktop configured."
